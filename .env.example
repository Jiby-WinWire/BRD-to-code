# ============================================================================
# AZURE OPENAI CONFIGURATION (Required)
# ============================================================================
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_KEY=your_api_key_here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt4o_mktgenai
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Legacy variable names (for backward compatibility)
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_MODEL_DEPLOYMENT=gpt4o_mktgenai

# ============================================================================
# REDIS CONFIGURATION (Required for state management)
# ============================================================================
REDIS_URL=redis://localhost:6379
# For Redis cluster (optional):
# REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002

# ============================================================================
# AZURE SEARCH CONFIGURATION (Optional - for semantic caching)
# ============================================================================
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your_search_key_here
AZURE_SEARCH_INDEX=brd-cache-index

# ============================================================================
# DISCOVERY SERVICE CONFIGURATION (Optional - for policy management)
# ============================================================================
DISCOVERY_API_URL=http://localhost:8090
CLIENT_ID=brd-to-code-client
CLIENT_SECRET=your_client_secret_here

# ============================================================================
# AGENT URLs (for A2A communication)
# ============================================================================
BRD_GENERATOR_URL=http://localhost:8001
STORY_GENERATOR_URL=http://localhost:8002
CODE_GENERATOR_URL=http://localhost:8003
TEST_GENERATOR_URL=http://localhost:8004
SUPERVISOR_URL=http://localhost:8000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_POLICY=false
ENABLE_CACHING=true
ENABLE_OBSERVABILITY=false

# ============================================================================
# JIRA CLOUD INTEGRATION (Optional)
# ============================================================================
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_USER_EMAIL=
